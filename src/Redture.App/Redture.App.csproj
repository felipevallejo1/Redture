<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: no console window when launched from Explorer or at logon. -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>Redture.App</RootNamespace>
    <AssemblyName>Redture</AssemblyName>

    <!--
      Becomes "File description" in the Windows version resource, which is the
      text shown in Task Manager's Description column, in the SmartScreen
      prompt, and in the file's Properties dialog. Left at the default it reads
      just "Redture", which tells somebody deciding whether to trust an
      unsigned download precisely nothing.
    -->
    <AssemblyTitle>Redture — display colour temperature and brightness</AssemblyTitle>
    <ApplicationIcon>Assets\redture.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!-- Compiled bindings: binding errors become compile errors instead of
         silent runtime failures. Requires x:DataType on every view. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Redture.Core\Redture.Core.csproj" />
    <ProjectReference Include="..\Redture.Platform.Abstractions\Redture.Platform.Abstractions.csproj" />
    <ProjectReference Include="..\Redture.Platform.Windows\Redture.Platform.Windows.csproj" />
    <ProjectReference Include="..\Redture.Platform.Linux\Redture.Platform.Linux.csproj" />
    <ProjectReference Include="..\Redture.Platform.MacOS\Redture.Platform.MacOS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
