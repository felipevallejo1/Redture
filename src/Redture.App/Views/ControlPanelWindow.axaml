<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Redture.App.ViewModels"
        xmlns:displays="clr-namespace:Redture.Platform.Abstractions.Displays;assembly=Redture.Platform.Abstractions"
        mc:Ignorable="d"
        x:Class="Redture.App.Views.ControlPanelWindow"
        x:DataType="vm:ControlPanelViewModel"
        Title="Redture"
        Icon="/Assets/redture.ico"
        Width="960" Height="660"
        MinWidth="420" MinHeight="460"
        Background="{StaticResource RedtureBackground}"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <!-- Card: the repeated container for every control group. -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource RedtureSurface}" />
      <Setter Property="BorderBrush" Value="{StaticResource RedtureBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,14,14" />
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource RedtureText}" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{StaticResource RedtureTextMuted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="16" />
    </Style>

    <Style Selector="TextBlock.value">
      <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
      <Setter Property="Foreground" Value="{StaticResource RedtureAccent}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- The coloured strip that sits under a slider and shows its range. -->
    <Style Selector="Border.scale">
      <Setter Property="Height" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Margin" Value="14,0,14,2" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>

    <Style Selector="Button">
      <Setter Property="Background" Value="{StaticResource RedtureSurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{StaticResource RedtureBorder}" />
      <Setter Property="Foreground" Value="{StaticResource RedtureText}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource RedtureAccentDeep}" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="{StaticResource RedtureSurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{StaticResource RedtureBorder}" />
      <Setter Property="Foreground" Value="{StaticResource RedtureText}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Language segments: radio buttons drawn as a two-part pill. -->
    <Style Selector="RadioButton.segment">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="chip" CornerRadius="11" Padding="10,3" Background="Transparent">
            <ContentPresenter Content="{TemplateBinding Content}"
                              FontSize="11" FontWeight="SemiBold"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Setter Property="Foreground" Value="{StaticResource RedtureTextMuted}" />
    </Style>

    <Style Selector="RadioButton.segment:checked /template/ Border#chip">
      <Setter Property="Background" Value="{StaticResource RedtureAccent}" />
    </Style>

    <Style Selector="RadioButton.segment:checked">
      <Setter Property="Foreground" Value="#20140C" />
    </Style>

    <!-- A monitor drawn as a monitor, rather than described in three lines. -->
    <Style Selector="Border.screen">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{StaticResource RedtureBorder}" />
      <Setter Property="Background" Value="#100C0A" />
    </Style>

    <Style Selector="Border.screen.primary">
      <Setter Property="BorderBrush" Value="{StaticResource RedtureAccent}" />
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">

    <!-- Header: spans the full width whatever the window is doing. -->
    <Border DockPanel.Dock="Top" Padding="20,16,20,14">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Offset="0" Color="#2A1A12" />
          <GradientStop Offset="1" Color="#17110F" />
        </LinearGradientBrush>
      </Border.Background>

      <Grid ColumnDefinitions="Auto,14,*,Auto,10,Auto,10,Auto">
        <Image Grid.Column="0" Source="/Assets/redture.ico" Width="34" Height="34"
               VerticalAlignment="Center" />

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Text="Redture" FontSize="19" FontWeight="Bold" />
          <TextBlock Classes="hint" Text="{Binding Strings.Tagline}" />
        </StackPanel>

        <!-- Language. Two small segments rather than a dropdown: with exactly
             two options a dropdown hides one of them behind a click. -->
        <Border Grid.Column="3" VerticalAlignment="Center"
                Background="{StaticResource RedtureSurface}"
                BorderBrush="{StaticResource RedtureBorder}"
                BorderThickness="1" CornerRadius="14" Padding="3">
          <StackPanel Orientation="Horizontal">
            <RadioButton Classes="segment" Content="EN" GroupName="lang"
                         IsChecked="{Binding IsEnglish, Mode=OneWay}"
                         Command="{Binding SetLanguageCommand}" CommandParameter="en" />
            <RadioButton Classes="segment" Content="ES" GroupName="lang"
                         IsChecked="{Binding IsSpanish, Mode=OneWay}"
                         Command="{Binding SetLanguageCommand}" CommandParameter="es" />
          </StackPanel>
        </Border>

        <!-- The things that used to sit in a footer nobody reads. -->
        <Border Grid.Column="5" VerticalAlignment="Center"
                Width="26" Height="26" CornerRadius="13"
                Background="{StaticResource RedtureSurface}"
                BorderBrush="{StaticResource RedtureBorder}" BorderThickness="1"
                ToolTip.Tip="{Binding HelpText}" ToolTip.ShowDelay="150">
          <TextBlock Text="?" FontSize="14" FontWeight="SemiBold"
                     Foreground="{StaticResource RedtureAccent}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <Border Grid.Column="7" VerticalAlignment="Center"
                Background="{StaticResource RedtureSurface}"
                BorderBrush="{StaticResource RedtureBorder}"
                BorderThickness="1"
                CornerRadius="14" Padding="12,5">
          <TextBlock Classes="value" FontSize="13"
                     Text="{Binding EffectiveTemperatureKelvin, StringFormat='{}{0} K'}" />
        </Border>
      </Grid>
    </Border>

    <!--
      Two columns that stack when there is no room for two.

      The wrapping happens between the columns rather than between the cards.
      A WrapPanel full of cards lays them out in rows, so one tall card sets the
      height of its whole row and leaves a hole beside it; wrapping whole
      columns instead lets each one pack its own cards tightly, and a narrow
      window simply puts the second column underneath the first.
    -->
    <ScrollViewer Padding="20,16,6,0">
      <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">

      <StackPanel Width="440">

        <!-- Conflict, shown only once another tool has been seen overwriting us -->
        <Border Classes="card"
                Background="#33E05252"
                BorderBrush="{StaticResource RedtureDanger}"
                IsVisible="{Binding HasConflict}">
          <StackPanel>
            <TextBlock Classes="section" Text="{Binding Strings.ConflictTitle}" />
            <TextBlock Classes="hint" Text="{Binding ConflictWarning}" />
          </StackPanel>
        </Border>

        <!-- Master switch -->
        <Border Classes="card">
          <StackPanel>
            <ToggleSwitch IsChecked="{Binding EffectsEnabled}"
                          OnContent="{Binding Strings.CorrectionsOn}"
                          OffContent="{Binding Strings.CorrectionsOff}" />
            <TextBlock Classes="hint"
                       Text="{Binding Strings.CorrectionsHint}" />
          </StackPanel>
        </Border>

        <!-- Brightness -->
        <Border Classes="card">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="section" Text="{Binding Strings.Brightness}" />
              <TextBlock Grid.Column="1" Classes="value"
                         Text="{Binding Brightness, StringFormat='{}{0:0} %'}" />
            </Grid>
            <Slider Minimum="{Binding MinBrightness}"
                    Maximum="{Binding MaxBrightness}"
                    Value="{Binding Brightness}"
                    TickFrequency="10" />
            <Border Classes="scale" Background="{StaticResource RedtureBrightnessScale}" />
            <TextBlock Classes="hint" Margin="0,8,0,0" Text="{Binding BacklightSummary}" />
            <TextBlock Classes="hint" Margin="0,6,0,0"
                       Text="{Binding Strings.OverlayHint}" />

            <ToggleSwitch Margin="0,10,0,0"
                          IsChecked="{Binding SuspendInFullscreen}"
                          OnContent="{Binding Strings.SuspendFullscreenOn}"
                          OffContent="{Binding Strings.SuspendFullscreenOff}" />
            <TextBlock Classes="hint" Text="{Binding FullscreenStatus}" />
          </StackPanel>
        </Border>

        <!-- Colour temperature -->
        <Border Classes="card">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="section" Text="{Binding Strings.ColourTemperature}" />
              <TextBlock Grid.Column="1" Classes="value"
                         Text="{Binding TemperatureKelvin, StringFormat='{}{0} K'}" />
            </Grid>
            <Slider Minimum="{Binding MinTemperatureKelvin}"
                    Maximum="{Binding MaxTemperatureKelvin}"
                    Value="{Binding TemperatureKelvin}"
                    TickFrequency="500"
                    IsEnabled="{Binding IsTemperatureManual}" />
            <Border Classes="scale" Background="{StaticResource RedtureTemperatureScale}" />
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,2,14,0">
              <TextBlock Grid.Column="0" Classes="hint" Text="{Binding Strings.ScaleWarm}" />
              <TextBlock Grid.Column="2" Classes="hint" Text="{Binding Strings.ScaleCool}" />
            </Grid>
            <TextBlock Classes="hint" Margin="0,8,0,0" Text="{Binding TemperatureStatus}" />
            <TextBlock Classes="hint" Margin="0,6,0,0"
                       Text="{Binding Strings.GammaHint}" />
          </StackPanel>
        </Border>

        <!-- Extended gamma range, offered only after a ramp was refused -->
        <Border Classes="card"
                Background="#33F0A030"
                BorderBrush="{StaticResource RedtureWarning}"
                IsVisible="{Binding CanOfferGammaRangeUnlock}">
          <StackPanel>
            <TextBlock Classes="section" Text="{Binding Strings.GammaRangeTitle}" />
            <TextBlock Classes="hint" Text="{Binding GammaRangeStatus}" />
            <TextBlock Classes="hint" Margin="0,8,0,4" Text="{Binding Strings.GammaRangeHowTo}" />

            <!-- Selectable so it can be read and copied, and never run by
                 Redture. See IGammaRangeUnlock.UnlockCommand for why. -->
            <Grid ColumnDefinitions="*,8,Auto">
              <TextBox Grid.Column="0"
                       Text="{Binding GammaRangeCommand, Mode=OneWay}"
                       IsReadOnly="True" FontSize="10"
                       FontFamily="Consolas,Menlo,monospace"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
              <Button Grid.Column="2" Content="{Binding Strings.Copy}"
                      Padding="10,5" FontSize="11"
                      VerticalAlignment="Center"
                      Click="OnCopyGammaCommand" />
            </Grid>
          </StackPanel>
        </Border>

      </StackPanel>

      <StackPanel Width="440">

        <!-- Automation -->
        <Border Classes="card">
          <StackPanel>
            <ToggleSwitch IsChecked="{Binding AutomationEnabled}"
                          OnContent="{Binding Strings.AutomationOn}"
                          OffContent="{Binding Strings.AutomationOff}" />
            <TextBlock Classes="hint" Text="{Binding ScheduleStatus}" />

            <TextBlock Classes="hint" Margin="0,6,0,0"
                       Foreground="{StaticResource RedtureWarning}"
                       IsVisible="{Binding HasScheduleFallbackWarning}"
                       Text="{Binding ScheduleFallbackWarning}" />

            <StackPanel IsVisible="{Binding AutomationEnabled}" Margin="0,12,0,0">

              <!-- No scale strip here. These two sliders share the range shown
                   on the colour temperature card, and a strip attached to one
                   of them reads as belonging to it alone. -->
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Strings.Daytime}" VerticalAlignment="Center" FontSize="12" />
                <TextBlock Grid.Column="1" Classes="value" FontSize="12"
                           Text="{Binding DayTemperatureKelvin, StringFormat='{}{0} K'}" />
              </Grid>
              <Slider Minimum="{Binding MinTemperatureKelvin}"
                      Maximum="{Binding MaxTemperatureKelvin}"
                      Value="{Binding DayTemperatureKelvin}"
                      TickFrequency="500" />

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Strings.Night}" VerticalAlignment="Center" FontSize="12" />
                <TextBlock Grid.Column="1" Classes="value" FontSize="12"
                           Text="{Binding NightTemperatureKelvin, StringFormat='{}{0} K'}" />
              </Grid>
              <Slider Minimum="{Binding MinTemperatureKelvin}"
                      Maximum="{Binding MaxTemperatureKelvin}"
                      Value="{Binding NightTemperatureKelvin}"
                      TickFrequency="500" />

              <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <TextBlock Grid.Column="0" Text="{Binding Strings.TransitionLength}" VerticalAlignment="Center" FontSize="12" />
                <TextBlock Grid.Column="1" Classes="value" FontSize="12"
                           Text="{Binding TransitionMinutes, StringFormat='{}{0} min'}" />
              </Grid>
              <Slider Minimum="1" Maximum="240"
                      Value="{Binding TransitionMinutes}"
                      TickFrequency="15" />
              <TextBlock Classes="hint"
                         Text="{Binding Strings.TransitionHint}" />

              <ToggleSwitch Margin="0,12,0,0"
                            IsChecked="{Binding UseSolarTimes}"
                            OnContent="{Binding Strings.AnchorSun}"
                            OffContent="{Binding Strings.AnchorClock}" />

              <Grid ColumnDefinitions="*,10,*" IsVisible="{Binding UseSolarTimes}">
                <StackPanel Grid.Column="0">
                  <TextBlock Classes="hint" Text="{Binding Strings.Latitude}" />
                  <TextBox Text="{Binding LatitudeText}" Watermark="-34.6" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Classes="hint" Text="{Binding Strings.Longitude}" />
                  <TextBox Text="{Binding LongitudeText}" Watermark="-58.4" FontSize="12" />
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="*,10,*" IsVisible="{Binding !UseSolarTimes}">
                <StackPanel Grid.Column="0">
                  <TextBlock Classes="hint" Text="{Binding Strings.Sunrise}" />
                  <TextBox Text="{Binding SunriseText}" Watermark="07:00" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Classes="hint" Text="{Binding Strings.Sunset}" />
                  <TextBox Text="{Binding SunsetText}" Watermark="20:00" FontSize="12" />
                </StackPanel>
              </Grid>

              <TextBlock Classes="hint" Margin="0,6,0,0"
                         IsVisible="{Binding UseSolarTimes}"
                         Text="{Binding Strings.LocationPrivacy}" />

              <TextBlock Classes="section" Margin="0,14,0,6" Text="{Binding Strings.OverrideTitle}" />
              <WrapPanel>
                <Button Content="{Binding Strings.PauseHour}" Margin="0,0,6,6" Padding="10,4" FontSize="11"
                        IsVisible="{Binding !IsScheduleOverridden}"
                        Command="{Binding PauseForAnHourCommand}" />
                <Button Content="{Binding Strings.PauseUntilMorning}" Margin="0,0,6,6" Padding="10,4" FontSize="11"
                        IsVisible="{Binding !IsScheduleOverridden}"
                        Command="{Binding PauseUntilSunriseCommand}" />
                <Button Content="{Binding Strings.CinemaMode}" Margin="0,0,6,6" Padding="10,4" FontSize="11"
                        IsVisible="{Binding !IsScheduleOverridden}"
                        Command="{Binding EnableCinemaModeCommand}" />
                <Button Content="{Binding Strings.ResumeSchedule}" Margin="0,0,6,6" Padding="10,4" FontSize="11"
                        IsVisible="{Binding IsScheduleOverridden}"
                        Command="{Binding ResumeScheduleCommand}" />
              </WrapPanel>
              <TextBlock Classes="hint"
                         Text="{Binding Strings.OverrideHint}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Startup -->
        <Border Classes="card" IsVisible="{Binding CanStartWithSystem}">
          <StackPanel>
            <ToggleSwitch IsChecked="{Binding StartWithSystem}"
                          OnContent="{Binding Strings.StartupOn}"
                          OffContent="{Binding Strings.StartupOff}" />
            <TextBlock Classes="hint"
                       Text="{Binding Strings.StartupHint}" />
          </StackPanel>
        </Border>

        <!-- Detected displays -->
        <Border Classes="card">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="section" Text="{Binding DisplaySummary}" />
              <Button Grid.Column="1" Content="{Binding Strings.Refresh}" Padding="10,3" FontSize="11"
                      Command="{Binding RefreshDisplaysCommand}" />
            </Grid>

            <!--
              Drawn to scale rather than listed. Where a second monitor sits
              relative to the first is the question this section exists to
              answer, and three lines of coordinates answer it slowly.
            -->
            <Border Margin="0,6,0,0" CornerRadius="8" Padding="6"
                    Background="#100C0A"
                    BorderBrush="{StaticResource RedtureBorder}" BorderThickness="1"
                    IsVisible="{Binding !!Displays.Count}">
              <ItemsControl ItemsSource="{Binding DisplayTiles}"
                            Height="{Binding DisplayMapHeight}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.Styles>
                  <Style Selector="ItemsControl > ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{ReflectionBinding X}" />
                    <Setter Property="Canvas.Top" Value="{ReflectionBinding Y}" />
                  </Style>
                </ItemsControl.Styles>

                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DisplayTile">
                    <Border Classes="screen"
                            Classes.primary="{Binding IsPrimary}"
                            Width="{Binding Width}" Height="{Binding Height}"
                            ToolTip.Tip="{Binding DeviceId}">
                      <StackPanel VerticalAlignment="Center" Margin="4">
                        <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Resolution}" FontSize="9"
                                   Foreground="{StaticResource RedtureTextMuted}"
                                   TextAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <TextBlock Classes="hint" Margin="0,8,0,0"
                       IsVisible="{Binding !Displays.Count}"
                       Text="{Binding Strings.NoDisplayBackend}" />
          </StackPanel>
        </Border>

      </StackPanel>

      </WrapPanel>
    </ScrollViewer>

  </DockPanel>

</Window>
