<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Redture.App.ViewModels"
        xmlns:displays="clr-namespace:Redture.Platform.Abstractions.Displays;assembly=Redture.Platform.Abstractions"
        mc:Ignorable="d"
        x:Class="Redture.App.Views.ControlPanelWindow"
        x:DataType="vm:ControlPanelViewModel"
        Title="Redture"
        Icon="/Assets/redture.ico"
        Width="440" Height="620"
        MinWidth="400" MinHeight="480"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <!-- Card: the repeated container for every control group. -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.value">
      <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="MinWidth" Value="64" />
    </Style>
  </Window.Styles>

  <ScrollViewer>
    <!-- Capped width: the panel is a narrow control surface, and letting the
         cards stretch across a resized window makes the sliders unusable. -->
    <StackPanel Margin="18" MaxWidth="520" HorizontalAlignment="Center">

      <!-- Header -->
      <StackPanel Margin="0,0,0,14">
        <TextBlock Text="Redture" FontSize="22" FontWeight="Bold" />
        <TextBlock Classes="hint" Text="Colour temperature and below-minimum brightness, in one control." />
      </StackPanel>

      <!-- Stage banner: removed once every effect is wired up. -->
      <Border Classes="card"
              Background="#33F0A030"
              BorderBrush="#80F0A030"
              BorderThickness="1">
        <StackPanel>
          <TextBlock Classes="section" Text="Stage 2 — colour temperature" />
          <TextBlock Classes="hint"
                     Text="Both controls are live. Brightness uses real backlight where the hardware allows it and a black overlay past the hardware minimum; colour temperature goes through the display's gamma ramp. Scheduling arrives in stage 3." />
          <TextBlock Classes="hint" Margin="0,6,0,0" Text="{Binding PanicHotkeyHint}" />
        </StackPanel>
      </Border>

      <!-- Master switch -->
      <Border Classes="card">
        <StackPanel>
          <ToggleSwitch IsChecked="{Binding EffectsEnabled}"
                        OnContent="Corrections enabled"
                        OffContent="Corrections disabled" />
          <TextBlock Classes="hint"
                     Text="Master switch. When off, Redture leaves the display completely untouched." />
        </StackPanel>
      </Border>

      <!-- Brightness -->
      <Border Classes="card">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="section" Text="Brightness" />
            <TextBlock Grid.Column="1" Classes="value"
                       Text="{Binding Brightness, StringFormat='{}{0:0} %'}" />
          </Grid>
          <Slider Minimum="{Binding MinBrightness}"
                  Maximum="{Binding MaxBrightness}"
                  Value="{Binding Brightness}"
                  TickFrequency="10"
                  IsSnapToTickEnabled="False" />
          <TextBlock Classes="hint" Text="{Binding BacklightSummary}" />
          <TextBlock Classes="hint" Margin="0,6,0,0"
                     Text="Below the handover the screen is dimmed with a click-through black overlay, which is a pure multiply: black stays black and contrast is preserved." />
        </StackPanel>
      </Border>

      <!-- Colour temperature -->
      <Border Classes="card">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="section" Text="Colour temperature" />
            <TextBlock Grid.Column="1" Classes="value"
                       Text="{Binding TemperatureKelvin, StringFormat='{}{0} K'}" />
          </Grid>
          <Slider Minimum="{Binding MinTemperatureKelvin}"
                  Maximum="{Binding MaxTemperatureKelvin}"
                  Value="{Binding TemperatureKelvin}"
                  TickFrequency="500"
                  IsSnapToTickEnabled="False" />
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0" Classes="hint" Text="warm" />
            <TextBlock Grid.Column="2" Classes="hint" Text="cool" />
          </Grid>
          <TextBlock Classes="hint" Margin="0,6,0,0" Text="{Binding TemperatureStatus}" />
          <TextBlock Classes="hint" Margin="0,6,0,0"
                     Text="Applied through the display's colour lookup table, before compositing — so the tint costs nothing to draw and never lifts the black level." />
        </StackPanel>
      </Border>

      <!-- Automation -->
      <Border Classes="card">
        <StackPanel>
          <ToggleSwitch IsChecked="{Binding AutomationEnabled}"
                        OnContent="Follow time of day"
                        OffContent="Manual control only" />
          <TextBlock Classes="hint"
                     Text="Gradual day / sunset / night transitions. Scheduling logic arrives in stage 3." />
        </StackPanel>
      </Border>

      <!-- Detected displays -->
      <Border Classes="card">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="section" Text="{Binding DisplaySummary}" />
            <Button Grid.Column="1"
                    Content="Refresh"
                    Padding="10,3"
                    FontSize="11"
                    Command="{Binding RefreshDisplaysCommand}" />
          </Grid>

          <ItemsControl ItemsSource="{Binding Displays}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="displays:DisplayInfo">
                <Border Margin="0,4,0,0" Padding="10,8"
                        CornerRadius="6"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="primary" FontSize="10" Opacity="0.7"
                                 IsVisible="{Binding IsPrimary}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock FontSize="11" Opacity="0.65"
                               Text="{Binding Bounds}" />
                    <TextBlock FontSize="11" Opacity="0.65"
                               Text="{Binding Id}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="hint" Margin="0,8,0,0"
                     IsVisible="{Binding !Displays.Count}"
                     Text="No display backend on this platform yet — Linux lands in stage 5, macOS in stage 6." />
        </StackPanel>
      </Border>

      <!-- Footer -->
      <StackPanel Margin="2,4,0,0" Spacing="2">
        <TextBlock Classes="hint" Text="{Binding VersionLabel}" />
        <TextBlock Classes="hint" Text="{Binding SettingsPath, StringFormat='Settings: {0}'}" />
        <TextBlock Classes="hint" Text="{Binding LogPath, StringFormat='Logs: {0}'}" />
        <TextBlock Classes="hint" Margin="0,6,0,0"
                   Text="Closing this window keeps Redture running in the tray. Use the tray menu to exit." />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>

</Window>
